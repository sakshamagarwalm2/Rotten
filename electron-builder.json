{
  "appId": "com.rotten.docxtoppt",
  "productName": "Rotten",
  "directories": {
    "output": "dist"
  },
  "files": [
    "electron/**/*",
    ".next/standalone/**/*",
    ".next/static/**/*",
    "public/**/*",
    "package.json"
  ],
  "asarUnpack": [
    ".next/standalone/**/*",
    ".next/static/**/*",
    "node_modules/next/**/*"
  ],
  "extraResources": [
    {
      "from": "tmp",
      "to": "tmp",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
